generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             String      @id @default(cuid())
  distributorSku String      @unique
  distributor    String
  brand          String
  name           String
  styleNumber    String
  description    String
  colors         String
  sizes          String
  priceBase      Float
  images         String
  category       String
  inventory      String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  OrderItems     OrderItem[]
}

model Design {
  id            String   @id @default(cuid())
  name          String?
  canvasJson    String
  previewUrl    String?
  productId     String
  productColor  String
  printLocation String   @default("front")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique
  status              String      @default("pending")
  customerName        String
  customerEmail       String
  customerPhone       String?
  shippingAddress     String
  items               OrderItem[]
  designId            String?
  design              Design?     @relation(fields: [designId], references: [id])
  subtotal            Float
  shipping            Float
  tax                 Float
  total               Float
  stripePaymentId     String?
  stripeSessionId     String?
  distributorOrderIds String?
  printReadyFiles     String?
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  color      String
  size       String
  quantity   Int
  unitPrice  Float
  printPrice Float
  total      Float
}

model CartItem {
  id         String   @id @default(cuid())
  sessionId  String
  productId  String
  color      String
  size       String
  quantity   Int
  designJson String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sessionId])
}
